rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Base para una aplicación de uso interno: cualquier usuario autenticado del proyecto
    // puede consultar y administrar los datos compartidos de la iglesia.
    // Para una congregación con varios equipos/iglesias, conviene agregar separación por churchId.
    match /{collection}/{document} {
      allow read, write: if request.auth != null
        && collection in ['services', 'songs', 'people', 'teams', 'serviceTypes', 'notes'];
    }
  }
}
