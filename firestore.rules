rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function base(c) { return /databases/$(database)/documents/churches/$(c); }
    function member(c) { return exists(base(c)/members/$(request.auth.uid)); }
    function rol(c) { return get(base(c)/members/$(request.auth.uid)).data.rol; }
    function editor(c) { return member(c) && rol(c) in ['admin','lider']; }
    match /users/{u} { allow read, write: if request.auth != null && request.auth.uid == u; }
    match /churches/{c} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null && member(c);
      allow update, delete: if request.auth != null && member(c) && rol(c) == 'admin';
      match /members/{u} {
        allow read: if request.auth != null && member(c);
        allow create: if request.auth != null && request.auth.uid == u && getAfter(base(c)).data.ownerUid == u;
        allow update, delete: if request.auth != null && member(c) && rol(c) == 'admin';
      }
      match /{col}/{id} {
        allow read: if request.auth != null && member(c);
        allow write: if request.auth != null && col != 'members' && editor(c);
      }
    }
  }
}
